# Backend configuration. Copy to `backend/.env` for local development.
# `backend/.env` is git-ignored. This file is safe to commit: it contains placeholders only.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Required. Must use the psycopg driver. Replace the placeholder password locally.
# Never commit a real connection string.
DATABASE_URL=postgresql+psycopg://rulesight:change-me-local-only@127.0.0.1:5432/rulesight

# The single browser origin allowed by CORS (scheme, host and port).
FRONTEND_ORIGIN=http://localhost:5173

# AI providers are disabled by default. No external AI call is made unless one is selected.
# Planned values: none | gemini (LLM); none | local | gemini (embeddings).
LLM_PROVIDER=none
LLM_MODEL=
EMBEDDING_PROVIDER=none

# Required only when LLM_PROVIDER=gemini. Keep this key out of version control.
GEMINI_API_KEY=
# Optional: cache model answers on disk so reruns are free and give the same result.
# LLM_CACHE_DIR=./storage/llm_cache
# Most regulation paragraphs read in one run (protects the model quota).
PIPELINE_MAX_PARAGRAPHS=30
# A run still "running" after this many minutes is treated as abandoned.
PIPELINE_RUN_TIMEOUT_MINUTES=30
# Retries when the model is rate limited or overloaded; waits double each time.
LLM_TRANSPORT_ATTEMPTS=6
LLM_RETRY_BACKOFF_SECONDS=3

# --- Local PostgreSQL (docker-compose.yml, read from this same file) -----------------------------
# Used by `docker compose`. Keep the values in sync with DATABASE_URL above.
POSTGRES_DB=rulesight
POSTGRES_USER=rulesight
# Local-only placeholder. Choose a different value for your machine. Never reuse it elsewhere.
POSTGRES_PASSWORD=change-me-local-only
# Host port bound to 127.0.0.1 only, so the database is not reachable from other machines.
POSTGRES_PORT=5432

# Sign-in tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when APP_ENV=production. If unset in development, a random key is used per process.
# JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# Password applied to the demo accounts by `uv run python scripts/set_user_passwords.py`.
# Not read by the API. Choose your own value locally; never commit a real one.
# DEMO_USER_PASSWORD=

# Document uploads: storage folder (relative to the working directory) and size limit.
STORAGE_DIR=storage
MAX_UPLOAD_MB=10

# Time zone for regulatory deadlines and "days remaining" on the dashboard.
BUSINESS_TIMEZONE=Asia/Kolkata

# Defaults for a drafted remediation when the gap's controls do not name an owner or evidence.
REMEDIATION_DEFAULT_OWNER_TEAM=Compliance Operations
REMEDIATION_DEFAULT_TARGET_DAYS=30
# REMEDIATION_DEFAULT_CLOSURE_EVIDENCE=

# Optional JSON file with the latest measured evaluation report (served by GET /eval/latest).
EVAL_REPORT_PATH=./storage/eval/latest.json

# Who is being assessed, in one sentence. Used to judge whether a clause applies.
# INSTITUTION_PROFILE=Example Bank Ltd., a scheduled commercial bank in India
# Risk formula weights and P1/P2 thresholds (editable JSON).
RISK_RULES_PATH=config/risk_rules.json
# Labelled answer key (CSV) used to score every pipeline run. Unset: runs are not scored.
# ANSWER_KEY_PATH=./demo_data/3_answer_key/expected_mappings_RBI.csv
LLM_TIMEOUT_SECONDS=180
PIPELINE_BATCH_CHARS=15000
LLM_MIN_INTERVAL_SECONDS=4
